      "@type": [
        "c4:Element",
        "c4:Person"
      ],
      "name": "Lector del mapa",
      "identifier": "lector",
      "description": "Quien abre el visor para mirar la red eléctrica, el agua o el transporte. Enciende capas, busca elementos y abre fichas.",
      "summary": "consulta la infraestructura",
      "tag": "PERSON · CIUDADANO",
      "level": 1,
      "isPartOf": "https://github.com/Ntizar/OpenInfraES#model:openinfraes",
      "order": 1,
