  "@graph": [
    {
      "@id": "https://github.com/Ntizar/OpenInfraES#model:openinfraes",
      "@type": "c4:Model",
      "title": "OpenInfraES architecture",
      "name": "OpenInfraES",
      "description": "Base de datos de infraestructura española y el mapa que la indexa. Sin backend: scripts que descargan de los organismos, un almacén de datos con su recibo de procedencia, un visor estático y dos puertas que impiden publicar un dato que no cuadre. Empieza por «Conectores» y sigue el flujo «Refresco de datos vivos».",
      "identifier": "openinfraes",
      "conformsTo": [
        "https://caviri.github.io/c4-model-agentic-plugin/ontology/c4",
        "https://caviri.github.io/c4-model-agentic-plugin/ontology/c4-view"
      ],
      "repository": "https://github.com/Ntizar/OpenInfraES",
      "branch": "main",
      "subtitle": "Ntizar/OpenInfraES",
      "toolbarTitle": "Arquitectura de OpenInfraES",
      "startLevel": 2,
      "defaultPins": [
        "https://github.com/Ntizar/OpenInfraES#lector",
        "https://github.com/Ntizar/OpenInfraES#openinfraes",
        "https://github.com/Ntizar/OpenInfraES#visor",
