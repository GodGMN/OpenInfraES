      "@id": "https://github.com/Ntizar/OpenInfraES#openinfraes",
      "@type": [
        "c4:Element",
        "c4:SoftwareSystem"
      ],
      "name": "OpenInfraES",
      "identifier": "openinfraes",
      "description": "El producto completo: pipeline de datos + almacén + visor publicado en GitHub Pages. No tiene servidor propio ni base de datos relacional.",
      "summary": "infraestructura de España en datos",
      "tag": "SOFTWARE SYSTEM · WEB ESTÁTICA",
      "level": 1,
      "technology": [
