:cfg-capas a c4:Element, c4:Component ;
    rdfs:label "CAPAS (declaración)" ;
    dcterms:identifier "cfg-capas" ;
    dcterms:description "Array que define cada capa: grupo, fichero, estilo, zoomMin, filtro y campos de la ficha. Añadir una capa es añadir una entrada aquí." ;
    c4:summary "una entrada por capa" ;
    c4:tag "CONFIG · 53 CAPAS" ;
