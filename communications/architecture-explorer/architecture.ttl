# OpenInfraES architecture · terms: https://caviri.github.io/c4-model-agentic-plugin/ontology/c4 , https://caviri.github.io/c4-model-agentic-plugin/ontology/c4-view
@prefix c4: <https://caviri.github.io/c4-model-agentic-plugin/ontology/c4#> .
@prefix c4v: <https://caviri.github.io/c4-model-agentic-plugin/ontology/c4-view#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix schema: <https://schema.org/> .
@prefix : <https://github.com/Ntizar/OpenInfraES#> .

:model:openinfraes a c4:Model ;
    dcterms:title "OpenInfraES architecture" ;
    rdfs:label "OpenInfraES" ;
    dcterms:description "Base de datos de infraestructura española y el mapa que la indexa. Sin backend: scripts que descargan de los organismos, un almacén de datos con su recibo de procedencia, un visor estático y dos puertas que impiden publicar un dato que no cuadre. Empieza por «Conectores» y sigue el flujo «Refresco de datos vivos»." ;
    dcterms:identifier "openinfraes" ;
    dcterms:conformsTo <https://caviri.github.io/c4-model-agentic-plugin/ontology/c4>,
        <https://caviri.github.io/c4-model-agentic-plugin/ontology/c4-view> ;
    dcterms:source <https://github.com/Ntizar/OpenInfraES> ;
    c4:branch "main" ;
    c4v:subtitle "Ntizar/OpenInfraES" ;
    c4v:toolbarTitle "Arquitectura de OpenInfraES" ;
    c4v:startLevel 2 ;
    c4v:defaultPins ( :lector :openinfraes :visor :almacen :gates :energia ) ;
    c4v:levelNames ( "Contexto" "Contenedores" "Componentes" "Código" ) ;
    dcterms:hasPart :lector, :openinfraes, :osm, :ign, :miteco, :energia, :transporte, :riesgo, :github .

:lector a c4:Element, c4:Person ;
    rdfs:label "Lector del mapa" ;
    dcterms:identifier "lector" ;
    dcterms:description "Quien abre el visor para mirar la red eléctrica, el agua o el transporte. Enciende capas, busca elementos y abre fichas." ;
    c4:summary "consulta la infraestructura" ;
    c4:tag "PERSON · CIUDADANO" ;
    c4:level 1 ;
    dcterms:isPartOf :model:openinfraes ;
    c4v:order 1 ;
    c4v:style "highlight" ;
    c4:uses :openinfraes .

:openinfraes a c4:Element, c4:SoftwareSystem ;
    rdfs:label "OpenInfraES" ;
    dcterms:identifier "openinfraes" ;
    dcterms:description "El producto completo: pipeline de datos + almacén + visor publicado en GitHub Pages. No tiene servidor propio ni base de datos relacional." ;
    c4:summary "infraestructura de España en datos" ;
    c4:tag "SOFTWARE SYSTEM · WEB ESTÁTICA" ;
    c4:level 1 ;
    c4:technology "Python", "JavaScript", "GitHub Pages" ;
    c4v:technologyList ( "Python" "JavaScript" "GitHub Pages" ) ;
    c4:path "README.md" ;
    c4:line 1 ;
    dcterms:isPartOf :model:openinfraes ;
    c4v:order 2 ;
    dcterms:hasPart :visor, :conectores, :almacen, :gates .

:osm a c4:Element, c4:SoftwareSystem, c4:ExternalSystem ;
    rdfs:label "OpenStreetMap" ;
    dcterms:identifier "osm" ;
    dcterms:description "Fuente comunitaria (ODbL): red de 220/400 kV, conducciones de agua y parte del transporte. Obliga a compartir igual el derivado." ;
    c4:summary "red, agua, transporte" ;
    c4:tag "EXTERNAL · OVERPASS" ;
    c4:level 1 ;
    rdfs:seeAlso <https://overpass-api.de> ;
    dcterms:isPartOf :model:openinfraes ;
    c4v:order 3 .

:ign a c4:Element, c4:SoftwareSystem, c4:ExternalSystem ;
    rdfs:label "IGN · WMTS" ;
    dcterms:identifier "ign" ;
    dcterms:description "Cartografía de fondo del mapa, servida por WMTS público del IGN. Se consume en tiempo de lectura, no se descarga al repo." ;
    c4:summary "teselas base sin clave" ;
    c4:tag "EXTERNAL · CARTOGRAFÍA" ;
    c4:level 1 ;
    rdfs:seeAlso <https://www.ign.es> ;
    dcterms:isPartOf :model:openinfraes ;
    c4v:order 4 .

:miteco a c4:Element, c4:SoftwareSystem, c4:ExternalSystem ;
    rdfs:label "MITECO" ;
    dcterms:identifier "miteco" ;
    dcterms:description "Embalses y parte hidrológica, registro de plantas de generación, residuos radiactivos y demarcaciones hidrográficas." ;
    c4:summary "embalses y plantas" ;
    c4:tag "EXTERNAL · AGUA" ;
    c4:level 1 ;
    rdfs:seeAlso <https://www.miteco.gob.es> ;
    dcterms:isPartOf :model:openinfraes ;
    c4v:order 5 .

:energia a c4:Element, c4:SoftwareSystem, c4:ExternalSystem ;
    rdfs:label "REE · ESIOS · OMIE" ;
    dcterms:identifier "energia" ;
    dcterms:description "Sistema eléctrico en vivo: demanda, mix de generación, precio, previsión e intercambios. ENTSO-E cubre lo que ESIOS no publica." ;
    c4:summary "demanda, mix, precio" ;
    c4:tag "EXTERNAL · ELÉCTRICO" ;
    c4:level 1 ;
    rdfs:seeAlso <https://www.ree.es> ;
    dcterms:isPartOf :model:openinfraes ;
    c4v:order 6 .

:transporte a c4:Element, c4:SoftwareSystem, c4:ExternalSystem ;
    rdfs:label "MITMA · NAP · Renfe" ;
    dcterms:identifier "transporte" ;
    dcterms:description "Carreteras y puertos (MITMA, visor Hermes), catálogo y líneas (NAP), vehículos de Cercanías (GTFS-RT) y tráfico de la DGT." ;
    c4:summary "trenes, puertos, DGT" ;
    c4:tag "EXTERNAL · TRANSPORTE" ;
    c4:level 1 ;
    rdfs:seeAlso <https://nap.transportes.gob.es> ;
    dcterms:isPartOf :model:openinfraes ;
    c4v:order 7 .

:riesgo a c4:Element, c4:SoftwareSystem, c4:ExternalSystem ;
    rdfs:label "CSN · EMSC · AEMET" ;
    dcterms:identifier "riesgo" ;
    dcterms:description "Sismicidad de la última semana (CSN/EMSC) y avisos meteorológicos de AEMET vía Meteoalarm." ;
    c4:summary "sismos y avisos" ;
    c4:tag "EXTERNAL · RIESGO" ;
    c4:level 1 ;
    rdfs:seeAlso <https://www.igme.es> ;
    dcterms:isPartOf :model:openinfraes ;
    c4v:order 8 .

:github a c4:Element, c4:SoftwareSystem, c4:ExternalSystem ;
    rdfs:label "GitHub · Pages" ;
    dcterms:identifier "github" ;
    dcterms:description "Aloja el repositorio, sirve el sitio estático desde la raíz y ejecuta los workflows que refrescan los datos." ;
    c4:summary "publica y ejecuta el CI" ;
    c4:tag "EXTERNAL · PLATAFORMA" ;
    c4:level 1 ;
    rdfs:seeAlso <https://ntizar.github.io/OpenInfraES/> ;
    dcterms:isPartOf :model:openinfraes ;
    c4v:order 9 ;
    c4:uses :visor .

:visor a c4:Element, c4:Container ;
    rdfs:label "Visor del mapa" ;
    dcterms:identifier "visor" ;
    dcterms:description "Página única de 2.588 líneas. Declara las 53 capas en un array y las carga bajo demanda con fetch; nada se descarga hasta que se enciende." ;
    c4:summary "index.html y 53 capas" ;
    c4:tag "CONTAINER · LEAFLET" ;
    c4:level 2 ;
    c4:technology "HTML", "JavaScript", "Leaflet" ;
    c4v:technologyList ( "HTML" "JavaScript" "Leaflet" ) ;
    c4:path "index.html" ;
    dcterms:isPartOf :openinfraes ;
    c4v:order 10 ;
    c4v:style "highlight" ;
    dcterms:hasPart :cfg-capas, :motor-capas, :render, :ficha, :leyenda, :procedencia-ui, :api-visual, :ciclo-capa ;
    c4:uses :ign .

:conectores a c4:Element, c4:Container ;
    rdfs:label "Conectores" ;
    dcterms:identifier "conectores" ;
    dcterms:description "Jobs batch que se ejecutan en local o en Actions: descargan del organismo, normalizan, simplifican si pesa y escriben el dato con su recibo." ;
    c4:summary "39 scripts, uno por fuente" ;
    c4:tag "CONTAINER · PYTHON" ;
    c4:level 2 ;
    c4:technology "Python 3.12", "requests" ;
    c4v:technologyList ( "Python 3.12" "requests" ) ;
    c4:path "scripts/" ;
    dcterms:isPartOf :openinfraes ;
    c4v:order 11 ;
    dcterms:hasPart :conectores-fuente, :normaliza, :simplificar, :agregados, :procedencia, :snapshot .

:almacen a c4:Element, c4:Container, c4:DataStore ;
    rdfs:label "Datos" ;
    dcterms:identifier "almacen" ;
    dcterms:description "El activo del proyecto: GeoJSON por capa, agregados CSV, fuentes.json y catalogo.json. Cada fichero lleva su recibo de procedencia y fecha." ;
    c4:summary "73 geojson + 30 recibos" ;
    c4:tag "DATA STORE · GEOJSON" ;
    c4:level 2 ;
    c4:technology "GeoJSON", "CSV", "JSON" ;
    c4v:technologyList ( "GeoJSON" "CSV" "JSON" ) ;
    c4:path "datos/" ;
    dcterms:isPartOf :openinfraes ;
    c4v:order 12 ;
    c4v:style "highlight" .

:gates a c4:Element, c4:Container ;
    rdfs:label "Arnés de datos" ;
    dcterms:identifier "gates" ;
    dcterms:description "Las dos puertas del proyecto: cuadres de datos y cifras de la documentación. Si una no pasa, el dato no sale." ;
    c4:summary "valida antes de publicar" ;
    c4:tag "CONTAINER · CI" ;
    c4:level 2 ;
    c4:technology "Python", "GitHub Actions" ;
