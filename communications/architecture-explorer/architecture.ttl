:leyenda a c4:Element, c4:Component ;
    rdfs:label "Leyenda" ;
    dcterms:identifier "leyenda" ;
    dcterms:description "Recalcula la leyenda al cambiar capas; para capas con escala pinta la rampa con sus extremos en vez de una lista." ;
