    rdfs:label "Conectores por fuente" ;
    dcterms:identifier "conectores-fuente" ;
    dcterms:description "Un script por organismo (descargar, hermes, nap, gtfsrt, dgt_rt, entsoe, omie, ree_vivo, sismos, irewater…). Escribe su recibo de descarga." ;
