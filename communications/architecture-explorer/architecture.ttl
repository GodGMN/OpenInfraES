:motor-capas a c4:Element, c4:Component ;
    rdfs:label "Motor de capas" ;
    dcterms:identifier "motor-capas" ;
    dcterms:description "Un solo camino para encender una capa: checkbox, vistas temáticas, enlace permanente y API llaman a ponerCapa(). cargar() hace un fetch por sesión." ;
    c4:summary "ponerCapa: un camino" ;
    c4:tag "COMPONENT · JS" ;
