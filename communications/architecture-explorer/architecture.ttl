:render a c4:Element, c4:Component ;
    rdfs:label "Render del mapa" ;
    dcterms:identifier "render" ;
    dcterms:description "Dibuja puntos (sólo los de la vista) y geometrías con L.geoJSON, con trazo oscuro en polígonos y atenuación por debajo de zoomMin." ;
