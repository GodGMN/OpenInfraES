:normaliza a c4:Element, c4:Component ;
    rdfs:label "normaliza.py" ;
    dcterms:identifier "normaliza" ;
    dcterms:description "Provincia y comunidad autónoma siempre por código oficial, nunca por nombre: el nombre cambia y el cruce por texto pierde datos en silencio." ;
